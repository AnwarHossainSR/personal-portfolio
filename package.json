{
  "name": "portfolio-anwar",
  "version": "1.0.0",
  "author": "Anwar Hossain",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": "please-use-yarn"
  },
  "scripts": {
    "dev": "next dev",
    "devt": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "analyze": "ANALYZE=true next build",
    "eslint": "next lint --fix --dir src",
    "prettier": "prettier --write .",
    "lint": "yarn eslint && yarn prettier",
    "format": "next lint --fix && prettier '**/*.{json,yaml}' --write --ignore-path .gitignore",
    "postbuild": "next-sitemap && yarn prisma generate",
    "postinstall": "yarn prisma generate"
  },
  "lint-staged": {
    "*.{js,jsx,md,ts,tsx,html,css,scss}": "yarn prettier",
    "*.{js,jsx,ts,tsx}": "eslint --cache --fix --cache-location ./node_modules/.cache/.eslintcache"
  },
  "dependencies": {
    "@emailjs/browser": "^4.3.3",
    "@next/bundle-analyzer": "^14.2.2",
    "@prisma/client": "^5.13.0",
    "autoprefixer": "^10.4.19",
    "axios": "^1.6.8",
    "bcrypt": "^5.1.1",
    "cloudinary": "2.0.0",
    "config": "^3.3.11",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.1.7",
    "jose": "^5.2.4",
    "jsonwebtoken": "^9.0.2",
    "next": "14.2.3",
    "next-sitemap": "^4.2.3",
    "prisma": "^5.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.3",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.1.0",
    "react-loader-spinner": "^6.1.6",
    "react-scroll": "^1.9.0",
    "sass": "^1.75.0",
    "sharp": "^0.33.3",
    "swiper": "^11.1.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/react-scroll": "^1.8.10",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-next": "14.1.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "typescript": "^5.4.3"
  }
}
